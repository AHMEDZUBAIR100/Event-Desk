# Environment Configuration Example
# Copy to .env and configure for local development

# Application
PROJECT_NAME="EventDesk"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database (PostgreSQL 16)
POSTGRES_USER="eventdesk"
POSTGRES_PASSWORD="eventdesk_secret"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="eventdesk_db"
DATABASE_URL="postgresql+asyncpg://eventdesk:eventdesk_secret@localhost:5432/eventdesk_db"

# pgAdmin 4 (Web UI Database Management)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL="admin@example.com"
PGADMIN_DEFAULT_PASSWORD="admin"

# Redis & Celery
REDIS_HOST="localhost"
REDIS_PORT=6379
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# Security & JWT Auth
# Generate random secret key: openssl rand -hex 32
SECRET_KEY="replace_with_a_secure_random_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email / Mailpit
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="noreply@eventdesk.local"
EMAILS_FROM_NAME="EventDesk Notifications"

# Frontend / CORS
FRONTEND_HOST="http://localhost:3000"
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
